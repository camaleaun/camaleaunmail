{
  "name": "camaleaunmail",
  "description": "Crimson Agility Mail — configures wp_mail to send via SMTP or Google Mail (OAuth 2.0).",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "readme": "grunt readme",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "playground": "wp-playground-cli server --mount=.:/wordpress/wp-content/plugins/camaleaunmail --login",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:update-snapshots": "playwright test --update-snapshots tests/e2e/visual.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@wordpress/scripts": "^30.0.0",
    "@wp-playground/cli": "^3.1.33",
    "grunt": "^1.6.2",
    "grunt-wp-readme-to-markdown": "^2.1.0"
  },
  "dependencies": {
    "@wordpress/icons": "^13.3.0"
  }
}
