#. Plugin Name of the plugin
#: camaleaunmail.php
msgid "Camaleaunmail"
msgstr "Camaleaunmail"

#. Plugin URI of the plugin
#: camaleaunmail.php
msgid "https://github.com/camaleaun/camaleaunmail"
msgstr "https://github.com/camaleaun/camaleaunmail"

#. Description of the plugin
#: camaleaunmail.php
msgid "Sends WordPress email through SMTP, logs every email and blocks sending on local sites."
msgstr "Envia os e-mails do WordPress por SMTP, registra todos os e-mails e bloqueia o envio em sites locais."

#. Author of the plugin
#: camaleaunmail.php
msgid "Gilberto Tavares"
msgstr "Gilberto Tavares"

#. Author URI of the plugin
#: camaleaunmail.php
msgid "https://github.com/camaleaun"
msgstr "https://github.com/camaleaun"

